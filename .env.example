# Copy to .env.local and fill in real values. Never commit real keys.

# LiveKit Cloud (cloud.livekit.io → Settings → Keys)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_OUTBOUND_TRUNK_ID=       # outbound SIP trunk (dials out via Twilio)
LIVEKIT_AGENT_NAME=arya          # worker name; /api/call dispatches to this

# Gemini via Vertex AI (agent worker auth)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=            # e.g. pure-silicon-501615-i9
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=  # path to service-account JSON key file

# Upstash Redis (guardrails)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

DAILY_CALL_CAP=20

# Google Sheets (parked — wire up later)
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SHEET_ID=
